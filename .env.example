# The live site address, e.g. https://dshnt.studio — used to build absolute
# links for the share preview image (WhatsApp, iMessage, LinkedIn, X).
NEXT_PUBLIC_SITE_URL=

# WhatsApp number with country code, digits only (e.g. 919876543210).
# Shows the "Message on WhatsApp" buttons when set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: every enquiry is POSTed as JSON to this URL
# (Google Apps Script, Zapier, Make, Slack/Discord webhook, etc.).
# Without it, enquiries are only printed to the server log.
LEAD_WEBHOOK_URL=
